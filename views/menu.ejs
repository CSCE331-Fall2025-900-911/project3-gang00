<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Menu</title>
  <link rel="stylesheet" id="mainStyleSheet" href="/styles.css">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
</head>

<body>
  <nav class="navbar" style="padding: 10px;">
    <div style="display: flex; flex-direction: row; align-items: center;">
        <a href="/kiosk" style="margin-left: 10px; margin-right: 20px;"><img src="/img/management/arrow-left.png" class="back-arrow"></a>
        <div>
            <p1 style="font-weight: 500;">Kiosk</p1>
            <h1 style="font-size: 50px; font-weight: 600; margin-top: -15px;">Menu</h1>
        </div>
        
    </div>
    <ul class="nav-links">
        <li><a href="javascript:void(0)" onclick="toggleStyleSheet()" style="display: flex; align-items: center; justify-content: center;">
            <img src="/brightness.png" style="width: 40px;">
        </a></li>
        <li>
            <button class="speaker-btn" id="textToSpeechBtn">
                <img src="/Muted.png" alt="Text-to-Speech" class="TextToSpeech-img" id="speakerImg">
            </button>
        </li>
        <li class="lang-dropdown no-translate">
            <button class="translate-btn" id="translateBtn">
                <img src="/Translate.png" alt="Translate" class="Translate-img" id="translateImg">
            </button>
            <div id="langMenu" class="lang-menu hidden">
                <select id="langSel" aria-label="Select language">
                    <option value="en" selected>English</option>
                    <option value="zh">中文</option>
                    <option value="es">Español</option>
                    <option value="fr">Français</option>
                    <option value="ja">日本語</option>
                </select>
            </div>
        </li>
    </ul>
</nav>

  <main class="menu-container" style="overflow-y: auto;">
    <div class="toolbar">
      <div>
        <button id="fontUp" type="button">A+</button>
        <button id="fontDown" type="button">A−</button>
      </div>
    </div>

    <% if (data && data.length > 0) { %>
      <% data.forEach(category => { %>
        <h1 class="menuH1" style="margin-top: 40px;"><%= category.category_name %></h1>
        <section class="menu-grid" aria-label="Drinks list">
        <% category.products.forEach(item => { %>
          <article class="menu-card" tabindex="0" aria-labelledby="title-<%= item.product_id %>">
            <% if (item.image_address) { %>
              <img src="<%= item.image_address %>" alt="<%= item.product_name %>"/>
            <% } %>
            <h3 id="title-<%= item.product_id %>"><%= item.product_name %></h3>
            <p class="price">$<%= Number(item.product_price).toFixed(2) %></p>
          </article>
        <% }); %>
      </section>
      <% }); %>
    <% } else { %>
      <p>No menu items found.</p>
    <% } %>
  </main>

  <script>
    // ---------- Font size controls ----------
    const root = document.documentElement;
    let base = 16;
    const up = document.getElementById('fontUp');
    const down = document.getElementById('fontDown');

    if (up && down) {
      up.onclick = () => {
        base = Math.min(base + 1, 22);
        root.style.fontSize = base + 'px';
      };
      down.onclick = () => {
        base = Math.max(base - 1, 14);
        root.style.fontSize = base + 'px';
      };
    }

    // ---------- Add-to-cart logic ----------
    function addToCart(productId, productName, productPrice) {
      const existing = JSON.parse(localStorage.getItem('orderData')) || {
        items: [],
        subtotal: 0
      };

      const item = {
        productId,
        productName,
        productPrice,
        isAddon: false
      };

      existing.items.push(item);
      existing.subtotal = (existing.subtotal || 0) + productPrice;

      localStorage.setItem('orderData', JSON.stringify(existing));

      alert(productName + ' added to cart.');
    }

    document.querySelectorAll('.add-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const card = btn.closest('.card');
        if (!card) return;

        const nameEl = card.querySelector('h3');
        const priceEl = card.querySelector('.price');
        if (!nameEl || !priceEl) return;

        const productName = nameEl.textContent.trim();
        const priceText = priceEl.textContent.replace('$', '').trim();
        const productPrice = parseFloat(priceText);
        const productId = parseInt(btn.dataset.id, 10);

        if (isNaN(productId) || isNaN(productPrice)) {
          console.error('Invalid product data for cart', { productId, productName, priceText });
          return;
        }

        addToCart(productId, productName, productPrice);
      });
    });
  </script>

  <script type="module" src="/langSelect.js"></script>
  <script src="/index.js"></script>
  <script src="/tts.js"></script>
  <script src="/accountDropdown.js"></script>
  <script src="/weather.js"></script>
  <script src="/style_sheet.js"></script>
</body>
</html>
