<!DOCTYPE html>
<head>
    <title>Track Your Order</title>
    <link rel="stylesheet" href="styles.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Ubuntu+Mono:ital,wght@0,400;0,700;1,400;1,700&display=swap" rel="stylesheet">
</head>
<body>
    <nav class="navbar" style="padding: 10px;">
    <div style="display: flex; flex-direction: row; align-items: center;">
        <a href="/kiosk" style="margin-left: 10px; margin-right: 20px;"><img src="/img/management/arrow-left.png" class="back-arrow"></a>
        <div>
            <p1 style="font-weight: 500;">Kiosk</p1>
            <h1 style="font-size: 50px; font-weight: 600; margin-top: -15px;">Track Order</h1>
        </div>
        
    </div>
    <ul class="nav-links">
        <li><a href="javascript:void(0)" onclick="toggleStyleSheet()" style="display: flex; align-items: center; justify-content: center;">
            <img src="/brightness.png" style="width: 40px;">
        </a></li>
        <li>
            <button class="speaker-btn" id="textToSpeechBtn">
                <img src="/Muted.png" alt="Text-to-Speech" class="TextToSpeech-img" id="speakerImg">
            </button>
        </li>
        <li class="lang-dropdown no-translate">
            <button class="translate-btn" id="translateBtn">
                <img src="/Translate.png" alt="Translate" class="Translate-img" id="translateImg">
            </button>
            <div id="langMenu" class="lang-menu hidden">
                <select id="langSel" aria-label="Select language">
                    <option value="en" selected>English</option>
                    <option value="zh">中文</option>
                    <option value="es">Español</option>
                    <option value="fr">Français</option>
                    <option value="ja">日本語</option>
                </select>
            </div>
        </li>
    </ul>
</nav>
    <div class="contactUs">
      <main>
        <section>
            <form action="/track" method="POST" class="contactGrid">
                <input type="text" name="orderNumber" placeholder="Your order number" value="<%= inputOrderId || '' %>" required/>
                <button type="submit">Track</button>
            </form>
        </section>

        <section class="trackResult">
          <% if (order) { %>
            <div class="card">
              <p><strong>Order ID:</strong> <%= order.order_id %></p>

              <% const timeStr = order.date_time && order.date_time.toLocaleString('en-US'); %>
              <% if (order.iscompleted) { %>
                <p><strong>Status:</strong> Completed</p>
                <p><strong>Completed at:</strong> <%= timeStr %></p>
              <% } else { %>
                <p><strong>Status:</strong> Not completed yet</p>
                <p><strong>Placed at:</strong> <%= timeStr %></p>
              <% } %>

              <p><strong>Order Items:</strong> 
                <ul>
                    <% orders.forEach(row => { %>
                      <li><%= row.product_name %> * <%= row.qty %></li>
                    <% }) %>
                </ul>
              </p>
              <br>
              <p><strong>Subtotal:</strong> $<%= order.sub_total %></p>

            </div>
          <% } else if (notFound) { %>
            <p class="error">No order found for ID <%= inputOrderId %>. Please check the number.</p>
          <% } %>
        </section>
    </main>
    </div>

    <script type="module" src="/langSelect.js"></script>
    <script src="/index.js"></script>
    <script src="/accountDropdown.js"></script>
    <script src="/weather.js"></script>
</body>